  "method": {
    "known_ad_intervals": "evaluation-windows clips source_start_seconds + ad_seconds",
    "coverage": "union of matched merged-block intersections divided by known interval duration",
    "missed_lead_tail": "covered union edge gaps; null when coverage is empty, with full interval in missed_uncovered_seconds",
    "spill": "matched-block duration outside the known interval, reported per matched block and as an outside union",
    "actual_A": "merged block attenuation_db, copied as actual_A_db",
    "positive_A_mergedblocks": "count of merged blocks with attenuation_db > 0 over total merged blocks",
    "attenuation_seconds": "sum of positive-A merged block durations divided by source format duration",
    "unmatched": "merged blocks without overlap with any known ad for that episode; not classified as false positives"
  },
